{
  "buildCommand": "npm run build",
  "outputDirectory": "site",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/me", "destination": "/" },
    { "source": "/me/:path*", "destination": "/" },
    { "source": "/u/:path*", "destination": "/" },
    { "source": "/leaderboard", "destination": "/" },
    { "source": "/search", "destination": "/" },
    { "source": "/teams", "destination": "/" }
  ]
}
